# Insight Advora LLP — environment variables. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=https://www.insightadvora.com

# Supabase (project ref kgyrgmylblfsznqbpdyv)
NEXT_PUBLIC_SUPABASE_URL=https://kgyrgmylblfsznqbpdyv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose to the browser

# Prisma (Supabase connection strings: Settings → Database)
DATABASE_URL=                         # pooled (port 6543, ?pgbouncer=true)
DIRECT_URL=                           # direct (port 5432) — used for migrations

# Auth
AUTH_SECRET=                          # openssl rand -base64 32
ADMIN_BOOTSTRAP_EMAIL=                # first admin user, created by seed script
ADMIN_BOOTSTRAP_PASSWORD=             # optional — if blank the seed prints a one-time random password

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email / CRM (future — leave blank until connected)
EMAIL_PROVIDER_API_KEY=
ENQUIRY_NOTIFY_TO=

# Analytics (optional — only loaded when set)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
